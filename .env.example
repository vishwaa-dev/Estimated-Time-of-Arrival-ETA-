# ============================================================
# RailCast AI — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file. Keys are read ONLY by the
# FastAPI backend; the frontend never sees them.
# ============================================================

# --- External APIs (server-side only) ---
RAILRADAR_API_KEY=
WEATHER_API_KEY=

RAILRADAR_BASE_URL=https://api.railradar.in/v1
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# --- Database ---
# SQLite (zero-install file database, created automatically on first run):
DATABASE_URL=sqlite:///./railcast.db

# --- Data mode ---
# LIVE  -> every tracked train refreshes from RailRadar
# DEMO  -> fully simulated journey, no external calls (hard zero-call mode)
# AUTO  -> per-train choice: LIVE switch on = real data; the designated demo
#          train replays its journey; others show their last real snapshot
DATA_MODE=AUTO

# --- The one train that runs the DEMO replay ---
DEMO_TRAIN_NUMBER=12637

# --- Polling / caching / API economy ---
POLL_INTERVAL_SECONDS=300
WEATHER_CACHE_TTL_SECONDS=600
TRAIN_CACHE_TTL_SECONDS=180
RAILRADAR_MAX_CALLS_PER_HOUR=30

# --- Prediction tuning ---
MAX_RECOVERY_MINUTES=20
RECOVERY_EFFICIENCY=0.5

# --- Demo simulation ---
DEMO_TIME_SCALE=60
DEMO_TICK_SECONDS=45

CORS_ORIGINS=http://localhost:3000
